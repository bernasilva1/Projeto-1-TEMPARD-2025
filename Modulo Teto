#include <Arduino.h>
#include <Adafruit_NeoPixel.h>
#include <WiFi.h>
#include <esp_now.h>

#define LED_PIN    8
#define NUM_PIXELS 1
#define PIR_PIN    4
#define BUTTON_PIN 3

Adafruit_NeoPixel rgbLed(NUM_PIXELS, LED_PIN, NEO_GRB + NEO_KHZ800);

enum STATE_ENUM{
  OFF, 
  ON,
  AUTO 
} system_state;

typedef struct struct_message {
  int mode;
  bool PirState;
  bool ledState;
  float temperature;
  float humidity;
} struct_message;

struct_message outgoingData;

// MAC do módulo chão (alterar)
uint8_t gatewayAddress[] = {0xFC,0x01,0x2C,0xF9,0x02,0xC8};

int buttonState;
int lastButtonState = HIGH;
unsigned long lastDebounceTime = 0;
const unsigned long debounceDelay = 50;

// Timer AUTO
unsigned long autoOffTimer = 0;
const unsigned long autoTimeout = 2000;

// --- Função de debounce ---
bool buttonPressed() {
  int reading = digitalRead(BUTTON_PIN);
  bool pressed = false;

  if (reading != lastButtonState) {
    lastDebounceTime = millis();
  }

  if ((millis() - lastDebounceTime) > debounceDelay) {
    if (reading != buttonState) {
      buttonState = reading;
      if (buttonState == LOW) {
        pressed = true;
      }
    }
  }

  lastButtonState = reading;
  return pressed;
}

// ----------------- Callback de envio -----------------
void onDataSent(const esp_now_send_info_t *send_info, esp_now_send_status_t status) {
  Serial.print("Enviado para MAC: ");
  for(int i=0;i<6;i++) Serial.printf("%02X:", send_info->src_addr[i]);
  Serial.print(" - Status: ");
  Serial.println(status == ESP_NOW_SEND_SUCCESS ? "OK" : "ERRO");

}

void setup() {
  Serial.begin(115200);

  rgbLed.begin();
  rgbLed.setPixelColor(0, rgbLed.Color(0,0,0));
  rgbLed.show();

  pinMode(PIR_PIN, INPUT);
  pinMode(BUTTON_PIN, INPUT_PULLUP);

  buttonState = digitalRead(BUTTON_PIN);
  lastButtonState = buttonState;

  system_state = OFF;

  WiFi.mode(WIFI_STA);
  WiFi.disconnect();

  if(esp_now_init() != ESP_OK){
    Serial.println("Erro ao iniciar ESP-NOW");
    return;
  }

  esp_now_register_send_cb(onDataSent);

  esp_now_peer_info_t peerInfo = {};
  memcpy(peerInfo.peer_addr, gatewayAddress, 6);
  peerInfo.encrypt = false;
  esp_now_add_peer(&peerInfo);

  
  Serial.println("Starting");
}

void loop() {

  
  if (buttonPressed()) {
    system_state = (STATE_ENUM)((system_state + 1) % 3);  // Vai trocando OFF→ON→AUTO→OFF
    autoOffTimer = 0;

    Serial.print("Modo alterado para: ");
    if (system_state == OFF)  Serial.println("OFF");
    if (system_state == ON)   Serial.println("ON");
    if (system_state == AUTO) Serial.println("AUTO");
  }

  switch (system_state) {

    // --- MODO OFF ---
    case OFF:
      rgbLed.setPixelColor(0, rgbLed.Color(0,0,0)); // Mantem desligado o LED rbg 
      rgbLed.show(); 
      break;

    // --- MODO ON ---
    case ON:
      rgbLed.setPixelColor(0, rgbLed.Color(255,255,255)); // Liga o LED rbg
      rgbLed.show();
      break;

    // --- MODO AUTO ---
    case AUTO: {
      int pirState = digitalRead(PIR_PIN);

      // Pir deteta movimento
      if (pirState == HIGH) {   
        rgbLed.setPixelColor(0, rgbLed.Color(255,255,255));
        rgbLed.show();
        autoOffTimer = millis();
      }

      // se deixar de detetar movimento ao final de 2000 ms o led desliga
      else if (autoOffTimer != 0 && (millis() - autoOffTimer > autoTimeout)) {
        rgbLed.setPixelColor(0, rgbLed.Color(0,0,0));
        rgbLed.show();
        Serial.println("Sem Movimento: LED desligado.");
        autoOffTimer = 0;
      }

    } break;
  }


  int PirState = digitalRead(PIR_PIN);
  // Envia estado do teto para o chão
  outgoingData.mode = system_state;
  outgoingData.PirState = (PirState==HIGH);
  outgoingData.ledState = (system_state==ON || (system_state==AUTO && PirState==HIGH));
  outgoingData.temperature = 0;
  outgoingData.humidity = 0;

  static unsigned long lastSend = 0;

  if (millis() - lastSend > 2000) {
    esp_now_send(gatewayAddress, (uint8_t*)&outgoingData, sizeof(outgoingData));
    lastSend = millis();
}
}
