#include <Arduino.h>
#include <WiFi.h>
#include <esp_now.h>
#include <DHT.h>

#define DHTPIN 4
#define DHTTYPE DHT11
DHT dht(DHTPIN, DHTTYPE);

typedef struct struct_message {
  int mode;
  bool pirState;
  bool ledState;
  bool buttonPressed; // não usado no chão
  float temperature;
  float humidity;
} struct_message;

struct_message incomingData;

// MAC do módulo teto 
uint8_t roofAddress[] = {0xFC,0x01,0x2C,0xF9,0x05,0x8C};

void onDataRecv(const esp_now_recv_info_t *recv_info, const uint8_t *data, int len){
  memcpy(&incomingData, data, sizeof(incomingData));

  Serial.print("Luz -> Modo: ");
  switch(incomingData.mode){
    case 0: Serial.print("OFF | "); break;
    case 1: Serial.print("ON | "); break;
    case 2: Serial.print("AUTO | "); break;
  }
  Serial.print("LED: "); Serial.println(incomingData.ledState ? "LIGADO":"DESLIGADO");

  // Mostra temperatura e umidade do chão
  float hum = dht.readHumidity();
  float temp = dht.readTemperature();
  if(!isnan(temp) && !isnan(hum)){
    Serial.print("Temperatura : "); Serial.print(temp); Serial.print(" °C  ");
    Serial.print("Humidade : "); Serial.print(hum); Serial.println(" %");
  }
  Serial.println("-------------------------------------------------------");
}

void onDataSent(const esp_now_send_info_t *send_info, esp_now_send_status_t status){
  // Não usamos envio no chão nesse caso
}

void setup(){
  Serial.begin(115200);
  dht.begin();

  WiFi.mode(WIFI_STA);
  WiFi.disconnect();

  if(esp_now_init()!=ESP_OK){
    Serial.println("Erro ESP-NOW");
    return;
  }

  esp_now_register_recv_cb(onDataRecv);

  esp_now_peer_info_t peerInfo = {};
  memcpy(peerInfo.peer_addr, roofAddress,6);
  peerInfo.encrypt=false;
  esp_now_add_peer(&peerInfo);

  Serial.println("Starting");
}

void loop(){
  delay(2000); // loop apenas para delay de leitura
}

